      <!-- ==========================================
                 RIGHT PANEL
                 (FORM LOGIN AKAN DITAMBAHKAN DI SINI)
            =========================================== -->

      <div class="w-full lg:w-7/12 bg-white p-8 lg:p-12 flex flex-col justify-center relative">

        <div class="max-w-md mx-auto w-full">

          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-slate-800">
              Selamat Datang
            </h2>

            <p class="text-slate-500 text-sm mt-2">
              Silakan masuk menggunakan akun Anda
            </p>
          </div>


          <!-- PILIH JENIS LOGIN -->

          <div class="bg-slate-100 p-1.5 rounded-xl flex mb-8 border border-slate-200 relative">

            <!-- KARYAWAN -->

            <button id="btnKaryawanTab" onclick="switchLoginTab('Karyawan')"
              class="login-tab flex-1 py-3 text-sm font-bold rounded-lg shadow-sm bg-white text-blue-700 ring-1 ring-black/5 flex items-center justify-center gap-2">

              <i class="fas fa-user-tie"></i>

              Karyawan

            </button>


            <!-- SUPERVISOR / ADMIN -->

            <button id="btnAdminTab" onclick="switchLoginTab('admin')"
              class="login-tab flex-1 py-3 text-sm font-medium rounded-lg text-slate-500 hover:text-slate-700 hover:bg-white/50 flex items-center justify-center gap-2">

              <i class="fas fa-user-shield"></i>

              Supervisor / Admin

            </button>

          </div>

          <form onsubmit="handleLogin(event)" class="space-y-5">

            <!-- FORM LOGIN KARYAWAN -->
            <div id="formKaryawanLogin" class="space-y-5 login-form-panel">

              <div>
                <label for="idKaryawan"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 ml-1">
                  ID Karyawan
                </label>

                <div class="relative group">
                  <div
                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-600 transition-colors">
                    <i class="far fa-id-card text-lg"></i>
                  </div>

                  <input type="text" id="idKaryawan" name="idKaryawan"
                    class="block w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400"
                    placeholder="Masukkan ID Karyawan" autocomplete="username">
                </div>
              </div>

              <div>
                <label for="passwordKaryawan"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 ml-1">
                  Password
                </label>

                <div class="relative group">
                  <div
                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-600 transition-colors">
                    <i class="fas fa-lock text-lg"></i>
                  </div>

                  <input type="password" id="passwordKaryawan" name="passwordKaryawan"
                    class="block w-full pl-12 pr-12 py-4 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400"
                    placeholder="Masukkan password" autocomplete="current-password">

                  <button type="button" onclick="togglePassword('passwordKaryawan', 'togglePasswordKaryawanIcon')"
                    class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer text-slate-400 hover:text-blue-600 transition-colors"
                    aria-label="Tampilkan password">
                    <i class="fas fa-eye" id="togglePasswordKaryawanIcon"></i>
                  </button>
                </div>
              </div>

            </div>


            <!-- FORM LOGIN SUPERVISOR / ADMIN -->
            <div id="formAdminLogin" class="hidden space-y-5 login-form-panel">

              <div>
                <label for="usernameAdmin"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 ml-1">
                  Username
                </label>

                <div class="relative group">
                  <div
                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-600 transition-colors">
                    <i class="far fa-user text-lg"></i>
                  </div>

                  <input type="text" id="usernameAdmin" name="usernameAdmin"
                    class="block w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400"
                    placeholder="Masukkan username" autocomplete="username">
                </div>
              </div>

              <div>
                <label for="passwordAdmin"
                  class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 ml-1">
                  Password
                </label>

                <div class="relative group">
                  <div
                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-blue-600 transition-colors">
                    <i class="fas fa-lock text-lg"></i>
                  </div>

                  <input type="password" id="passwordAdmin" name="passwordAdmin"
                    class="block w-full pl-12 pr-12 py-4 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all placeholder-slate-400"
                    placeholder="Masukkan password" autocomplete="current-password">

                  <button type="button" onclick="togglePassword('passwordAdmin', 'togglePasswordAdminIcon')"
                    class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer text-slate-400 hover:text-blue-600 transition-colors"
                    aria-label="Tampilkan password">
                    <i class="fas fa-eye" id="togglePasswordAdminIcon"></i>
                  </button>
                </div>
              </div>

            </div>


            <!-- TOMBOL LOGIN -->
            <button type="submit"
              class="w-full py-4 px-6 bg-gradient-to-r from-blue-700 to-blue-800 hover:from-blue-800 hover:to-blue-900 text-white font-bold rounded-xl shadow-lg shadow-blue-900/20 transition-all transform active:scale-[0.98] text-sm flex justify-center items-center gap-2 group">

              <span>MASUK SEKARANG</span>

              <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>

            </button>

            <!-- LUPA / GANTI PASSWORD KARYAWAN -->
            <div class="text-center pt-1">
              <button type="button" onclick="openForgotPasswordModal()"
                class="text-xs font-bold text-blue-700 hover:text-blue-900 hover:underline transition-colors">
                <i class="fas fa-key mr-1"></i>Lupa / Ganti Password?
              </button>
            </div>

          </form>

          <div id="loginError"
            class="mt-6 hidden p-4 bg-red-50 border border-red-100 rounded-xl flex items-start gap-3 animate-fade-in">
            <div class="p-2 bg-red-100 rounded-full text-red-600 shrink-0">
              <i class="fas fa-exclamation-triangle text-xs"></i>
            </div>
            <div>
              <h4 class="text-sm font-bold text-red-700">Akses Ditolak</h4>
              <p id="errorText" class="text-xs text-red-600 mt-0.5">Username atau password salah.</p>
            </div>
          </div>

        </div>
      </div>
    </div>

    <p class="absolute bottom-6 text-slate-500 text-xs font-medium opacity-60">
      © 2026 Sistem Absensi SPBU. V11
    </p>
  </div>


