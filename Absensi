        </div>


        <!-- Dark Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/95 via-slate-900/70 to-slate-900/40">
        </div>


        <!-- LEFT CONTENT -->

        <div class="relative z-10">


          <!-- LOGO + NAMA SPBU -->

          <div class="flex items-center gap-3 mb-6">

            <!-- Logo Pertamina -->
            <div
              class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20 shadow-lg">

              <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTVGEvQJQI_giq1s0WepVhemlr7pdZnftNzGQ3kCA2Axw&s=10" alt="Logo Pertamina" class="w-7 h-7 object-contain">

            </div>


            <!-- Nama dan Nomor SPBU -->
            <div>

              <span class="block font-bold tracking-wider text-sm text-blue-100/90">
                SPBU KOTOBARU CAHAYA UTAMA
              </span>

              <span class="block text-xs text-blue-200/70 mt-1">
                No. SPBU 13.262.515
              </span>

            </div>

          </div>


          <!-- JUDUL -->

          <h1 class="text-4xl lg:text-5xl font-bold leading-tight mb-4 text-white drop-shadow-sm">

            Sistem Absensi
            <br>

            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-cyan-200">
              Digital
            </span>

